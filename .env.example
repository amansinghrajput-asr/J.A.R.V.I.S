# ==============================================================================
# J.A.R.V.I.S — Environment Configuration Template
# ==============================================================================

# Application Information
APP_NAME=J.A.R.V.I.S
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# AI & LLM Providers (Zero-cost / Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_HISTORY_LIMIT=20

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Voice & Speech Settings
LANGUAGE=en
WAKE_WORD=jarvis
WAKE_PHRASES=Hey Jarvis, Activate Jarvis, Jarvis Activate, Jarvish Activate, Hello Jarvis
TTS_VOICE=en-GB-RyanNeural

# Logging Settings
LOG_LEVEL=INFO

# Custom Directory Overrides (Optional — defaults to project subdirectories)
# DATA_DIR=
# MODELS_DIR=
# LOGS_DIR=
# CONFIG_DIR=
